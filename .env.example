# Copy to .env.local. For local stack: `supabase start` and paste the printed URL + anon key.
# For a hosted project: Dashboard → Settings → API. Only the public anon/publishable key goes
# here: every VITE_ variable ships to the browser. Never put the service-role key in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Demo mode (optional) ─────────────────────────────────────────────────────
# Shows "Try the demo" one-click logins on the sign-in page. Only for a demo/test database seeded
# with supabase/demo/demo_environment.sql (private.reset_demo()); these accounts are public by
# design and the data resets nightly. Put real values in .env.demo.local and run/build with --mode demo.
# Never enable this against production (scc-prod).
# VITE_DEMO_MODE=true
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_PARENT_EMAIL=
# VITE_DEMO_PARENT_PASSWORD=
# VITE_DEMO_VOLUNTEER_EMAIL=
# VITE_DEMO_VOLUNTEER_PASSWORD=
# VITE_DEMO_APPLICANT_EMAIL=
# VITE_DEMO_APPLICANT_PASSWORD=
