VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Demo mode (optional) ─────────────────────────────────────────────────────
# Shows "Try the demo" one-click logins on the sign-in page. Only for a demo/test database seeded
# with migration_demo_environment.sql (private.reset_demo()); these accounts are public by design
# and the data resets nightly. Put real values in .env.demo.local and run/build with --mode demo.
# VITE_DEMO_MODE=true
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_PARENT_EMAIL=
# VITE_DEMO_PARENT_PASSWORD=
# VITE_DEMO_VOLUNTEER_EMAIL=
# VITE_DEMO_VOLUNTEER_PASSWORD=
# VITE_DEMO_APPLICANT_EMAIL=
# VITE_DEMO_APPLICANT_PASSWORD=
